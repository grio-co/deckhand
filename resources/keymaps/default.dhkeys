bind alt+shift+w deck3.hotcue_clear.6 desc="Delete hot cue 6"
bind alt+shift+e deck3.hotcue_clear.7 desc="Delete hot cue 7"
bind alt+shift+r deck3.hotcue_clear.8 desc="Delete hot cue 8"
bind alt+a deck3.cue mode=hold
bind alt+s deck3.play
bind alt+d deck3.sync
bind alt+f ui.load.3
bind alt+g deck3.memory_cue_set
bind alt+shift+a deck3.cue_set desc="Set the main cue point at the playhead"
bind alt+shift+s deck3.pfl
bind alt+shift+d deck3.key_lock
bind alt+shift+f deck3.tempo 0 desc="Reset the tempo fader to zero"
bind mod+shift+g deck3.suggest_cues desc="Suggest cues for deck 3 from the phrase analysis (free hot slots only)"
bind alt+shift+g deck3.memory_cue_delete desc="Delete the memory cue nearest the playhead"
bind alt+z deck3.loop_in
bind alt+x deck3.loop_out
bind alt+c deck3.loop_scale 0.5 desc="Halve the loop"
bind alt+v deck3.loop_scale 2 desc="Double the loop"
