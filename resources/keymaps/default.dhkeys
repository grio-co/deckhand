# DeckHand default keyboard shortcuts.
#
# Do not edit this file to customise: your own changes live in keymap.dhkeys in DeckHand's data folder
# (Settings > Keyboard shortcuts writes it) and are applied on top, so updates can add shortcuts without
# losing yours. Format and examples: docs/SHORTCUTS.md.
#
#   bind   <chord> <control> [value] [mode=press|hold|toggle|repeat] [context=global|browser|text] [desc="..."]
#   unbind <chord> [context=...]
#
# Chords name the physical key (by its US-layout name), so the layout under your fingers follows the keyboard
# you have. `mod` is Command on macOS and Control elsewhere. Controls are the names of the control table
# (GET /v1/controls) plus the application actions called ui.*.
#
# Layout: left hand = deck 1, right hand = deck 2, mirrored. Decks 3 and 4 use the same keys with Alt held.
#   pads      deck 1: 1 2 3 4 / Q W E R        deck 2: 7 8 9 0 / U I O P     (Shift + pad clears the hot cue)
#   transport deck 1: A cue, S play, D sync, F load   deck 2: ; cue, L play, K sync, J load
#   loops     deck 1: Z in, X out, C halve, V double, B loop   deck 2: / in, . out, , halve, M double, N loop
# Nothing here uses Cmd+Q, W, H, M, Tab or Space, which macOS keeps for itself.


# ---- deck 1
bind 1 deck1.hotcue.1 mode=hold desc="Hot cue 1: set it, or jump to it while held"
bind 2 deck1.hotcue.2 mode=hold desc="Hot cue 2: set it, or jump to it while held"
bind 3 deck1.hotcue.3 mode=hold desc="Hot cue 3: set it, or jump to it while held"
bind 4 deck1.hotcue.4 mode=hold desc="Hot cue 4: set it, or jump to it while held"
bind q deck1.hotcue.5 mode=hold desc="Hot cue 5: set it, or jump to it while held"
bind w deck1.hotcue.6 mode=hold desc="Hot cue 6: set it, or jump to it while held"
bind e deck1.hotcue.7 mode=hold desc="Hot cue 7: set it, or jump to it while held"
bind r deck1.hotcue.8 mode=hold desc="Hot cue 8: set it, or jump to it while held"
bind shift+1 deck1.hotcue_clear.1 desc="Delete hot cue 1"
bind shift+2 deck1.hotcue_clear.2 desc="Delete hot cue 2"
bind shift+3 deck1.hotcue_clear.3 desc="Delete hot cue 3"
bind shift+4 deck1.hotcue_clear.4 desc="Delete hot cue 4"
bind shift+q deck1.hotcue_clear.5 desc="Delete hot cue 5"
bind shift+w deck1.hotcue_clear.6 desc="Delete hot cue 6"
bind shift+e deck1.hotcue_clear.7 desc="Delete hot cue 7"
bind shift+r deck1.hotcue_clear.8 desc="Delete hot cue 8"
bind a deck1.cue mode=hold
bind s deck1.play
bind d deck1.sync
bind f ui.load.1
bind g deck1.memory_cue_set
bind shift+a deck1.cue_set desc="Set the main cue point at the playhead"
bind shift+s deck1.pfl
bind shift+d deck1.key_lock
bind shift+f deck1.tempo 0 desc="Reset the tempo fader to zero"
bind mod+g deck1.suggest_cues desc="Suggest cues for deck 1 from the phrase analysis (free hot slots only)"
bind shift+g deck1.memory_cue_delete desc="Delete the memory cue nearest the playhead"
bind z deck1.loop_in
bind x deck1.loop_out
bind c deck1.loop_scale 0.5 desc="Halve the loop"
bind v deck1.loop_scale 2 desc="Double the loop"
bind b deck1.loop
bind shift+b deck1.reloop
bind 5 deck1.beatjump -4 desc="Jump back 4 beats"
bind t deck1.beatjump 4 desc="Jump forward 4 beats"
bind shift+5 deck1.beatjump -1 desc="Jump back 1 beat"
bind shift+t deck1.beatjump 1 desc="Jump forward 1 beat"
bind shift+z ui.nudge.1 -0.01 mode=repeat desc="Pitch bend down (nudge back)"
bind shift+x ui.nudge.1 0.01 mode=repeat desc="Pitch bend up (nudge forward)"
bind minus deck1.wave_zoom_out
bind equals deck1.wave_zoom_in

# ---- deck 2
bind 7 deck2.hotcue.1 mode=hold desc="Hot cue 1: set it, or jump to it while held"
bind 8 deck2.hotcue.2 mode=hold desc="Hot cue 2: set it, or jump to it while held"
bind 9 deck2.hotcue.3 mode=hold desc="Hot cue 3: set it, or jump to it while held"
bind 0 deck2.hotcue.4 mode=hold desc="Hot cue 4: set it, or jump to it while held"
bind u deck2.hotcue.5 mode=hold desc="Hot cue 5: set it, or jump to it while held"
bind i deck2.hotcue.6 mode=hold desc="Hot cue 6: set it, or jump to it while held"
bind o deck2.hotcue.7 mode=hold desc="Hot cue 7: set it, or jump to it while held"
bind p deck2.hotcue.8 mode=hold desc="Hot cue 8: set it, or jump to it while held"
bind shift+7 deck2.hotcue_clear.1 desc="Delete hot cue 1"
bind shift+8 deck2.hotcue_clear.2 desc="Delete hot cue 2"
bind shift+9 deck2.hotcue_clear.3 desc="Delete hot cue 3"
bind shift+0 deck2.hotcue_clear.4 desc="Delete hot cue 4"
bind shift+u deck2.hotcue_clear.5 desc="Delete hot cue 5"
bind shift+i deck2.hotcue_clear.6 desc="Delete hot cue 6"
bind shift+o deck2.hotcue_clear.7 desc="Delete hot cue 7"
bind shift+p deck2.hotcue_clear.8 desc="Delete hot cue 8"
bind semicolon deck2.cue mode=hold
bind l deck2.play
bind k deck2.sync
bind j ui.load.2
bind h deck2.memory_cue_set
bind shift+semicolon deck2.cue_set desc="Set the main cue point at the playhead"
bind shift+l deck2.pfl
bind shift+k deck2.key_lock
bind shift+j deck2.tempo 0 desc="Reset the tempo fader to zero"
bind mod+j deck2.suggest_cues desc="Suggest cues for deck 2 from the phrase analysis (free hot slots only)"
bind shift+h deck2.memory_cue_delete desc="Delete the memory cue nearest the playhead"
bind slash deck2.loop_in
bind period deck2.loop_out
bind comma deck2.loop_scale 0.5 desc="Halve the loop"
bind m deck2.loop_scale 2 desc="Double the loop"
bind n deck2.loop
bind shift+n deck2.reloop
bind 6 deck2.beatjump -4 desc="Jump back 4 beats"
bind y deck2.beatjump 4 desc="Jump forward 4 beats"
bind shift+6 deck2.beatjump -1 desc="Jump back 1 beat"
bind shift+y deck2.beatjump 1 desc="Jump forward 1 beat"
bind shift+comma ui.nudge.2 -0.01 mode=repeat desc="Pitch bend down (nudge back)"
bind shift+period ui.nudge.2 0.01 mode=repeat desc="Pitch bend up (nudge forward)"
bind lbracket deck2.wave_zoom_out
bind rbracket deck2.wave_zoom_in

# ---- stems (decks 1 and 2; the track needs separated stems): Mod+Alt+digit mutes a stem, hold the isolate key to solo it
bind mod+alt+1 deck1.stem.vocals.mute desc="Deck 1: mute / unmute the vocals stem"
bind mod+alt+2 deck1.stem.drums.mute desc="Deck 1: mute / unmute the drums stem"
bind mod+alt+3 deck1.stem.bass.mute desc="Deck 1: mute / unmute the bass stem"
bind mod+alt+4 deck1.stem.other.mute desc="Deck 1: mute / unmute the other stem"
bind mod+alt+q deck1.stem.vocals.isolate mode=hold desc="Deck 1: solo the vocals while held"
bind mod+alt+w deck1.stem.drums.isolate mode=hold desc="Deck 1: solo the drums while held"
bind mod+alt+e deck1.stems.acapella desc="Deck 1: vocals only"
bind mod+alt+r deck1.stems.instrumental desc="Deck 1: everything except the vocals"
bind mod+alt+5 deck1.stems.reset desc="Deck 1: all stems back on"
bind mod+alt+7 deck2.stem.vocals.mute desc="Deck 2: mute / unmute the vocals stem"
bind mod+alt+8 deck2.stem.drums.mute desc="Deck 2: mute / unmute the drums stem"
bind mod+alt+9 deck2.stem.bass.mute desc="Deck 2: mute / unmute the bass stem"
bind mod+alt+0 deck2.stem.other.mute desc="Deck 2: mute / unmute the other stem"
bind mod+alt+u deck2.stem.vocals.isolate mode=hold desc="Deck 2: solo the vocals while held"
bind mod+alt+i deck2.stem.drums.isolate mode=hold desc="Deck 2: solo the drums while held"
bind mod+alt+o deck2.stems.acapella desc="Deck 2: vocals only"
bind mod+alt+p deck2.stems.instrumental desc="Deck 2: everything except the vocals"
bind mod+alt+6 deck2.stems.reset desc="Deck 2: all stems back on"

