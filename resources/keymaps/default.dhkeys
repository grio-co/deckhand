# ---- browser: move, load, search
bind up ui.browse_up mode=repeat context=browser
bind down ui.browse_down mode=repeat context=browser
bind pageup ui.browse_page_up mode=repeat context=browser
bind pagedown ui.browse_page_down mode=repeat context=browser
bind home ui.browse_top context=browser
bind end ui.browse_bottom context=browser
bind tab ui.browse_switch context=browser
bind enter ui.load_free context=browser
bind shift+left ui.load.1 context=browser
bind shift+right ui.load.2 context=browser
bind alt+shift+left ui.load.3 context=browser
bind alt+shift+right ui.load.4 context=browser
bind mod+up ui.playlist_prev context=browser
bind mod+down ui.playlist_next context=browser
bind mod+f ui.focus_search
bind mod+shift+f ui.clear_search

# ---- pre-listen (headphones only)
bind space ui.preview_toggle context=browser
bind shift+space ui.preview_stop context=browser
bind alt+left ui.preview_seek -10 mode=repeat context=browser desc="Skip back 10 s in the pre-listen"
bind alt+right ui.preview_seek 10 mode=repeat context=browser desc="Skip forward 10 s in the pre-listen"

# ---- tracks: rate, tag, collect
bind mod+0 ui.rate 0 desc="Clear the rating"
bind mod+1 ui.rate 1 desc="Rate 1 star"
bind mod+2 ui.rate 2 desc="Rate 2 stars"
bind mod+3 ui.rate 3 desc="Rate 3 stars"
bind mod+4 ui.rate 4 desc="Rate 4 stars"
bind mod+5 ui.rate 5 desc="Rate 5 stars"
bind mod+equals ui.rate_up
bind mod+minus ui.rate_down
bind mod+p ui.add_to_prepare
bind mod+shift+p ui.add_to
bind mod+i ui.edit_track
bind mod+z ui.undo_edit context=browser

# ---- play queue and automix
bind mod+e ui.queue_add desc="Add the selected tracks to the end of the play queue"
bind mod+shift+e ui.queue_play_next desc="Play the selected tracks next"
bind mod+shift+a automix.run desc="Start or stop automix"
bind mod+shift+c ui.controller desc="Open or close the connected controller's panel (mapping, jog and LED settings)"
bind mod+shift+k automix.pause desc="Pause or resume automix"
bind mod+shift+n automix.skip desc="Automix: start the next transition now, on the next bar"
# ---- step sequencer (the sampler's pattern player), controller deck side, linked mix points
bind mod+shift+r seq.run desc="Start or stop the step sequencer"
bind mod+shift+t seq.record desc="Sequencer: record sampler hits into the pattern while it runs"
bind mod+shift+x seq.clear desc="Sequencer: empty the pattern being played"
bind mod+alt+shift+1 seq.pattern.1.queue desc="Sequencer: play pattern 1 from the next bar"
bind mod+alt+shift+2 seq.pattern.2.queue desc="Sequencer: play pattern 2 from the next bar"
bind mod+alt+shift+3 seq.pattern.3.queue desc="Sequencer: play pattern 3 from the next bar"
bind mod+alt+shift+4 seq.pattern.4.queue desc="Sequencer: play pattern 4 from the next bar"
bind mod+alt+shift+5 seq.pattern.5.queue desc="Sequencer: play pattern 5 from the next bar"
bind mod+alt+shift+6 seq.pattern.6.queue desc="Sequencer: play pattern 6 from the next bar"
bind mod+alt+shift+7 seq.pattern.7.queue desc="Sequencer: play pattern 7 from the next bar"
bind mod+alt+shift+8 seq.pattern.8.queue desc="Sequencer: play pattern 8 from the next bar"
bind mod+shift+d ui.controller.switch_decks desc="Switch a controller with switchable deck sides to its other pair of decks"
bind mod+shift+l ui.link.1.2 desc="Link the playhead of deck 1 to the playhead of deck 2 (a mix point between the two tracks)"
bind mod+shift+b ui.link.2.1 desc="Link the playhead of deck 2 to the playhead of deck 1"
# ---- suggestions and preparation
bind f9 ui.suggestions desc="What goes well after the track on air"
bind mod+shift+y ui.queue_suggestion desc="Play the top suggestion next"
bind f10 ui.prep desc="Preparation mode: two headphone players on decks 3 and 4"
# ---- mixer
bind mod+left mixer.crossfader 0 desc="Crossfader fully left"
bind mod+right mixer.crossfader 1 desc="Crossfader fully right"
bind mod+shift+down mixer.crossfader 0.5 desc="Crossfader to the centre"

# ---- panels and windows
bind mod+comma ui.settings
bind f1 ui.shortcuts
bind f2 ui.sampler
bind f3 ui.learn
bind f4 ui.columns
bind mod+shift+h ui.trash desc="Trash and edit history"
bind mod+alt+shift+c ui.chain desc="Effect chain editor"
bind mod+shift+o ui.layouts desc="Browser layouts (saved column sets)"
bind mod+shift+period ui.layout_next desc="Next browser layout"
bind mod+shift+comma ui.layout_prev desc="Previous browser layout"
bind mod+shift+u ui.locate desc="Find moved or renamed files"
bind mod+alt+shift+v ui.capture desc="Record from an analogue input and split into tracks"
bind mod+shift+s ui.shared_playlist desc="Shared playlist: share the selected playlist, join one, sync, stop sharing"
bind mod+alt+shift+m ui.metadata desc="Metadata fill: look up the selected tracks (opt-in)"
bind mod+shift+m ui.split desc="Split the browser: side by side, stacked, off"
bind mod+shift+i ui.focus_pane desc="Keyboard focus to the other track table"
bind f5 ui.compatible
bind f6 ui.layout
bind f7 ui.skin_next
bind f8 ui.cheat_sheet
bind mod+b ui.window.browser
bind escape ui.close_panel

# ---- key sync (mod+alt, home row: deck 1 left hand, deck 2 right hand; add shift for decks 3 and 4)
bind mod+alt+a deck1.key_sync desc="Deck 1: key sync on / off (follows the other deck's key as tempos change)"
bind mod+alt+s deck1.key_match desc="Deck 1: match the other deck's key once"
bind mod+alt+f deck1.key_reset desc="Deck 1: key shift back to 0, key sync off"
bind mod+alt+z ui.key_shift.1 -1 desc="Deck 1: key down one semitone"
bind mod+alt+x ui.key_shift.1 1 desc="Deck 1: key up one semitone"
bind mod+alt+semicolon deck2.key_sync desc="Deck 2: key sync on / off (follows the other deck's key as tempos change)"
bind mod+alt+l deck2.key_match desc="Deck 2: match the other deck's key once"
bind mod+alt+j deck2.key_reset desc="Deck 2: key shift back to 0, key sync off"
bind mod+alt+comma ui.key_shift.2 -1 desc="Deck 2: key down one semitone"
bind mod+alt+period ui.key_shift.2 1 desc="Deck 2: key up one semitone"
bind mod+alt+shift+a deck3.key_sync desc="Deck 3: key sync on / off (follows the other deck's key as tempos change)"
bind mod+alt+shift+s deck3.key_match desc="Deck 3: match the other deck's key once"
bind mod+alt+shift+f deck3.key_reset desc="Deck 3: key shift back to 0, key sync off"
bind mod+alt+shift+z ui.key_shift.3 -1 desc="Deck 3: key down one semitone"
bind mod+alt+shift+x ui.key_shift.3 1 desc="Deck 3: key up one semitone"
bind mod+alt+shift+semicolon deck4.key_sync desc="Deck 4: key sync on / off (follows the other deck's key as tempos change)"
bind mod+alt+shift+l deck4.key_match desc="Deck 4: match the other deck's key once"
bind mod+alt+shift+j deck4.key_reset desc="Deck 4: key shift back to 0, key sync off"
bind mod+alt+shift+comma ui.key_shift.4 -1 desc="Deck 4: key down one semitone"
bind mod+alt+shift+period ui.key_shift.4 1 desc="Deck 4: key up one semitone"
