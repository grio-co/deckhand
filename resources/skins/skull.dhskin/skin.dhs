// Skull: an X-ray skull as a free-form, multi-window skin. The two huge eye sockets are the decks (jog platter, read-outs and
// overview inside; the scrolling waveform runs as one ribbon through the middle of both eyes), the teeth are the hot-cue pads (top)
// and the key / range / stem buttons (bottom), the cheekbones carry cue memory and loops, the temples the tempo faders, the ears
// the module buttons, the open mouth the mixer, the mandible load / eject / grid and the crossfader (along the chin), and the seven
// vertebrae the effects, master, microphone and application buttons. Every empty area is transparent and clicks fall through.
// Library (ribcage), sampler (femur), grid tools (tray) and the library tools / settings panels (trays) float on their own.
// Art: img/*.png from tools/make_skull_art.py. Shells without several windows dock the visible modules beside the skull.
dhskin 1

meta name="Skull" author="DeckHand contributors" license="MIT" min_version="0.1" description="X-ray skull: decks in the eye sockets, mixer in the open mouth, effects down the spine; library, sampler and tools float as bones"

tokens {
  color bg       #081522
  color panel    #0b1b2e
  color panel2   #12293f
  color line     #3f78a8
  color text     #e8f6ff
  color dim      #9ec2de
  color accent   #3fe6ff
  color deck1    #3fe6ff
  color deck2    #ffc245
  color deck3    #a678ff
  color deck4    #ff6ba8
  color good     #4be0a0
  color warn     #ffc245
  color bad      #ff5a6e
  color hover    #3fe6ff30
  color press    #3fe6ff55
  color glass    #02070ee6
  color socket   #040b14
  color ink      #0c2236
  color deck1d   #067c9c
  color deck2d   #9a6400
  font ui    size=12
  font small size=10 bold=true
  font title size=14 bold=true
  font big   size=24 bold=true
}

atlas main     src="img/main.png"     { region full 0 0 2200 2880 }
atlas ribcage  src="img/browser.png"  { region full 0 0 1600 940 }
atlas femur    src="img/sampler.png"  { region full 0 0 1000 380 }
atlas gridtray src="img/grid.png"     { region full 0 0 1400 600 }
atlas toolstray src="img/tools.png"   { region full 0 0 1400 1040 }
atlas setstray src="img/settings.png" { region full 0 0 1440 1120 }

strings {
  skull.grid "GRID"
  skull.close "x"
  skull.eject "EJECT"
  skull.zero "0"
  skull.loop_in "IN"
  skull.loop_out "OUT"
}

animation beat_glow property=glow from=1 to=0 duration=160 ease=out trigger=beat

window main size=1100x1440 min=550x720 title="@app.title" chrome=none background=transparent mask="img/main.png" mask_threshold=128 scale=fit scale_min=40 scale_max=200 scale_default=70 snap=true shadow=auto {
  resize {
    ellipse cx=968 cy=462 rx=19 ry=19
  }
  snap_point 550,1440
  snap_point 0,720
  snap_point 1100,720
  free sprite="main:full" {
    // ---- deck A: eye socket
    arc bind="mixer.ch[1].level" color=deck1 x=154 y=128 w=316 h=316 start=135 end=405 thickness=5
    jog bind="deck[1].jog" color=deck1 bg=socket border=deck1 border_w=1 radius=144 glow=deck1 glow_r=10 anim=beat_glow x=168 y=142 w=288 h=288
    label bind="deck[1].letter" font=title color=deck1 text_align=center x=292 y=150 w=40 h=16 
    label bind="deck[1].title" font=title color=text text_align=center x=217 y=168 w=190 h=18 
    label bind="deck[1].artist" font=ui color=dim text_align=center x=222 y=187 w=180 h=14 
    waveform bind="deck[1].waveform" mode=zoomed color=deck1 bg=glass radius=3 x=174 y=244 w=372 h=84
    label bind="deck[1].bpm" font=big color=text text_align=left x=200 y=334 w=96 h=28 
    label bind="deck[1].key" font=small color=dim text_align=left x=200 y=363 w=44 h=14 
    label bind="deck[1].key_shift" font=small color=deck1 text_align=left x=248 y=363 w=44 h=14 
    label bind="deck[1].time" font=title color=text text_align=right x=316 y=338 w=108 h=18 
    label bind="deck[1].remaining" font=small color=dim text_align=right x=316 y=358 w=108 h=14 
    waveform bind="deck[1].waveform" mode=overview color=deck1 bg=glass radius=3 x=226 y=382 w=172 h=18
    label bind="deck[1].loop" font=small color=accent text_align=center x=267 y=403 w=90 h=14 
    // ---- deck A: brow
    button bind="deck[1].play" text="@deck.play" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=345 y=36 w=54 h=32 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[1].cue" text="@deck.cue" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=403 y=36 w=46 h=32 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    button bind="deck[1].sync" text="@deck.sync" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=453 y=36 w=46 h=32 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].key_lock" text="@deck.key_lock" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=262 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].quantize" text="@deck.quantize" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=308 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].slip" text="@deck.slip" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=354 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].reverse" text="@deck.reverse" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=400 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.edit" text="@skull.grid" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=446 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    // ---- deck A: bridge key shift, temple tempo
    button bind="deck[1].key_shift.minus" text="@deck.key_down" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=494 y=112 w=28 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    label bind="deck[1].key_shift" font=small color=deck1 text_align=center x=524 y=118 w=52 h=14 
    button bind="deck[1].key_shift.plus" text="@deck.key_up" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=578 y=112 w=28 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    label bind="deck[1].tempo" font=small color=ink text_align=center x=88 y=190 w=56 h=14 
    path bind="deck[1].tempo" d="M 38 6 Q 8 102 38 198" viewbox=56x204 color=deck1 thickness=5 handle=9 x=88 y=206 w=56 h=204
    // ---- deck A: cheekbone cue memory and loops
    button bind="deck[1].cue.memory_set" text="@cue.mem_add" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=176 y=478 w=64 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].cue.memory_delete" text="@cue.mem_del" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=244 y=478 w=64 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].cue.memory_prev" text="@cue.mem_prev" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=312 y=478 w=64 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].cue.memory_next" text="@cue.mem_next" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=380 y=478 w=64 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].cue.loop_save" text="@cue.loop_save" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=176 y=512 w=86 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].cue.loop_recall" text="@cue.loop_recall" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=266 y=512 w=86 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].cue.suggest" text="@cue.suggest" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=356 y=512 w=86 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].loop_in" text="@skull.loop_in" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=176 y=546 w=64 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].loop_out" text="@skull.loop_out" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=244 y=546 w=64 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    // ---- deck A: upper teeth = hot cues, lower teeth = key shift, range, stems
    pads bind="deck[1].pads" cols=8 rows=1 gap=4 radius=8 color=deck1 x=230 y=576 w=316 h=60
    button bind="deck[1].key_shift.minus" text="@deck.key_down" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=230 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].key_shift.reset" text="@skull.zero" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=270 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].key_shift.plus" text="@deck.key_up" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=310 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].tempo_range" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=350 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].stem.vocals.active" text="@deck.stem_vocals" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=390 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[1].stem.drums.active" text="@deck.stem_drums" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=430 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[1].stem.bass.active" text="@deck.stem_bass" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=470 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[1].stem.other.active" text="@deck.stem_other" font=small color=text bg=panel border=deck1 border_w=1 radius=8 transition=90 x=510 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    // ---- deck A: mandible
    button bind="deck[1].load" text="@browser.load" args="deck=A" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=262 y=884 w=76 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].eject" text="@skull.eject" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=342 y=884 w=70 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    button bind="deck[1].grid.edit" text="@deck.grid_edit" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=262 y=922 w=76 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    button bind="deck[1].metronome" text="@grid.click" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=342 y=922 w=70 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    // ---- deck A: mixer channel in the mouth
    knob bind="mixer.ch[1].trim" text="@mixer.trim" color=deck1 font=small  x=338 y=660 w=44 h=60
    knob bind="mixer.ch[1].eq.high" text="@mixer.eq.high" color=deck1 font=small  x=384 y=660 w=44 h=60
    knob bind="mixer.ch[1].eq.mid" text="@mixer.eq.mid" color=deck1 font=small  x=430 y=660 w=44 h=60
    knob bind="mixer.ch[1].eq.low" text="@mixer.eq.low" color=deck1 font=small  x=476 y=660 w=44 h=60
    knob bind="mixer.ch[1].filter" text="@mixer.filter" color=text font=small  bipolar=true x=522 y=660 w=44 h=60
    fader bind="mixer.ch[1].fader" orientation=horizontal color=deck1 bg=glass radius=3 x=576 y=672 w=118 h=22
    meter bind="mixer.ch[1].level" orientation=horizontal bg=glass x=576 y=700 w=118 h=8
    button bind="mixer.ch[1].cue" text="@mixer.cue" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=704 y=674 w=56 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    // ---- deck A: effect slots on the vertebrae C1-C3
    button bind="deck[1].fx[1].select" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=292 y=1071 w=78 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].fx[1].on" text="@fx.on" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=374 y=1071 w=34 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    fader bind="deck[1].fx[1].wet" orientation=horizontal color=deck1 bg=glass radius=3 x=412 y=1074 w=64 h=22
    button bind="deck[1].fx[2].select" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=292 y=1123 w=78 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].fx[2].on" text="@fx.on" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=374 y=1123 w=34 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    fader bind="deck[1].fx[2].wet" orientation=horizontal color=deck1 bg=glass radius=3 x=412 y=1126 w=64 h=22
    button bind="deck[1].fx[3].select" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=292 y=1175 w=78 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].fx[3].on" text="@fx.on" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=374 y=1175 w=34 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    fader bind="deck[1].fx[3].wet" orientation=horizontal color=deck1 bg=glass radius=3 x=412 y=1178 w=64 h=22
    // ---- deck B: eye socket
    arc bind="mixer.ch[2].level" color=deck2 x=630 y=128 w=316 h=316 start=135 end=405 thickness=5
