    button bind="deck[2].cue.memory_next" text="@cue.mem_next" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=860 y=478 w=64 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].cue.loop_save" text="@cue.loop_save" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=656 y=512 w=86 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
