    label bind="deck[2].key" font=small color=dim text_align=left x=676 y=363 w=44 h=14 
    label bind="deck[2].key_shift" font=small color=deck2 text_align=left x=724 y=363 w=44 h=14 
    label bind="deck[2].time" font=title color=text text_align=right x=792 y=338 w=108 h=18 
    label bind="deck[2].remaining" font=small color=dim text_align=right x=792 y=358 w=108 h=14 
    waveform bind="deck[2].waveform" mode=overview color=deck2 bg=glass radius=3 x=702 y=382 w=172 h=18
    label bind="deck[2].loop" font=small color=accent text_align=center x=743 y=403 w=90 h=14 
    // ---- deck B: brow
    button bind="deck[2].play" text="@deck.play" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=601 y=36 w=54 h=32 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[2].cue" text="@deck.cue" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=659 y=36 w=46 h=32 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    button bind="deck[2].sync" text="@deck.sync" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=709 y=36 w=46 h=32 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].key_lock" text="@deck.key_lock" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=612 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].quantize" text="@deck.quantize" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=658 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].slip" text="@deck.slip" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=704 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].reverse" text="@deck.reverse" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=750 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].grid.edit" text="@skull.grid" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=796 y=74 w=42 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    // ---- deck B: bridge key shift, temple tempo
    button bind="deck[2].key_shift.minus" text="@deck.key_down" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=494 y=142 w=28 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    label bind="deck[2].key_shift" font=small color=deck2 text_align=center x=524 y=148 w=52 h=14 
