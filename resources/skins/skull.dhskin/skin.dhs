    path bind="deck[2].tempo" d="M 18 6 Q 48 102 18 198" viewbox=56x204 color=deck2 thickness=5 handle=9 x=956 y=206 w=56 h=204
    // ---- deck B: cheekbone cue memory and loops
    button bind="deck[2].cue.memory_set" text="@cue.mem_add" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=656 y=478 w=64 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].cue.memory_delete" text="@cue.mem_del" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=724 y=478 w=64 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
