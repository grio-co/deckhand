    button bind="deck[2].key_shift.plus" text="@deck.key_up" font=small color=text bg=panel border=deck2 border_w=1 radius=8 transition=90 x=630 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].tempo_range" font=small color=text bg=panel border=deck2 border_w=1 radius=8 transition=90 x=670 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].stem.vocals.active" text="@deck.stem_vocals" font=small color=text bg=panel border=deck2 border_w=1 radius=8 transition=90 x=710 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[2].stem.drums.active" text="@deck.stem_drums" font=small color=text bg=panel border=deck2 border_w=1 radius=8 transition=90 x=750 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[2].stem.bass.active" text="@deck.stem_bass" font=small color=text bg=panel border=deck2 border_w=1 radius=8 transition=90 x=790 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[2].stem.other.active" text="@deck.stem_other" font=small color=text bg=panel border=deck2 border_w=1 radius=8 transition=90 x=830 y=806 w=36 h=56 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    // ---- deck B: mandible
    button bind="deck[2].load" text="@browser.load" args="deck=B" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=688 y=884 w=76 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].eject" text="@skull.eject" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=768 y=884 w=70 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    button bind="deck[2].grid.edit" text="@deck.grid_edit" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=688 y=922 w=76 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    button bind="deck[2].metronome" text="@grid.click" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=768 y=922 w=70 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    // ---- deck B: mixer channel in the mouth
    knob bind="mixer.ch[2].trim" text="@mixer.trim" color=deck2 font=small  x=338 y=724 w=44 h=60
    knob bind="mixer.ch[2].eq.high" text="@mixer.eq.high" color=deck2 font=small  x=384 y=724 w=44 h=60
    knob bind="mixer.ch[2].eq.mid" text="@mixer.eq.mid" color=deck2 font=small  x=430 y=724 w=44 h=60
    knob bind="mixer.ch[2].eq.low" text="@mixer.eq.low" color=deck2 font=small  x=476 y=724 w=44 h=60
    knob bind="mixer.ch[2].filter" text="@mixer.filter" color=text font=small  bipolar=true x=522 y=724 w=44 h=60
    fader bind="mixer.ch[2].fader" orientation=horizontal color=deck2 bg=glass radius=3 x=576 y=736 w=118 h=22
    meter bind="mixer.ch[2].level" orientation=horizontal bg=glass x=576 y=764 w=118 h=8
    button bind="mixer.ch[2].cue" text="@mixer.cue" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=704 y=738 w=56 h=30 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    // ---- deck B: effect slots on the vertebrae C1-C3
    button bind="deck[2].fx[1].select" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=730 y=1071 w=78 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].fx[1].on" text="@fx.on" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=692 y=1071 w=34 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    fader bind="deck[2].fx[1].wet" orientation=horizontal color=deck2 bg=glass radius=3 x=624 y=1074 w=64 h=22
    button bind="deck[2].fx[2].select" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=730 y=1123 w=78 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].fx[2].on" text="@fx.on" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=692 y=1123 w=34 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    fader bind="deck[2].fx[2].wet" orientation=horizontal color=deck2 bg=glass radius=3 x=624 y=1126 w=64 h=22
    button bind="deck[2].fx[3].select" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=730 y=1175 w=78 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="deck[2].fx[3].on" text="@fx.on" font=small color=text bg=panel border=deck2 border_w=1 radius=6 transition=90 x=692 y=1175 w=34 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    fader bind="deck[2].fx[3].wet" orientation=horizontal color=deck2 bg=glass radius=3 x=624 y=1178 w=64 h=22
    // ---- centre of the skull
    meter bind="mixer.master.level" orientation=horizontal bg=glass x=505 y=46 w=90 h=10
    // ears: module buttons (left), application buttons (right)
    button action="window.toggle:browser" text="@window.browser" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=169 y=656 w=56 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button action="window.toggle:sampler" text="@window.sampler" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=180 y=694 w=56 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    button action="window.toggle:grid" text="@skull.grid" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=191 y=732 w=56 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    // the right ear is the mirror image
    button bind="app.settings" text="@app.settings" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=875 y=656 w=56 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="app.skin" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=864 y=694 w=56 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="app.language" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=853 y=732 w=56 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    // ---- mixer: crossfader along the chin, headphone cue, master
    label text="@mixer.crossfader" font=small color=ink text_align=center x=450 y=930 w=200 h=14 
    label bind="deck[1].letter" font=title color=deck1d text_align=center x=410 y=960 w=20 h=16 
    label bind="deck[2].letter" font=title color=deck2d text_align=center x=670 y=960 w=20 h=16 
    path bind="mixer.crossfader" d="M 10 8 Q 120 54 230 8" viewbox=240x60 color=accent thickness=6 handle=11 x=430 y=956 w=240 h=60
    // ---- spine C4 master, C5 microphone, C6 application, C7 status
    knob bind="mixer.master.volume" text="@mixer.master" color=text font=small bg=panel radius=8  x=294 y=1218 w=52 h=46
    knob bind="mixer.headphone.volume" text="@mixer.headphones" color=text font=small bg=panel radius=8  x=350 y=1218 w=52 h=46
    knob bind="mixer.headphone.mix" text="@mixer.headphone_mix" color=text font=small bg=panel radius=8  x=406 y=1218 w=52 h=46
    knob bind="mixer.sampler.level" text="@mixer.sampler" color=accent font=small bg=panel radius=8  x=750 y=1218 w=56 h=46
    meter bind="mixer.master.level" orientation=horizontal bg=glass x=496 y=1237 w=108 h=8
    button bind="mixer.mic.on" text="@mixer.mic" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=292 y=1279 w=54 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="mixer.mic.talkover" text="@mixer.talkover" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=350 y=1279 w=54 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    fader bind="mixer.mic.level" orientation=horizontal color=text bg=glass radius=3 x=408 y=1282 w=68 h=22
    meter bind="mixer.mic.meter" orientation=horizontal bg=glass x=658 y=1288 w=150 h=10
    button bind="app.rec" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=292 y=1331 w=90 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    button bind="app.export" text="@app.export_usb" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=386 y=1331 w=90 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="app.import" text="@app.import_library" show="app.has_import" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=714 y=1331 w=94 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="app.learn" text="@app.learn" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=624 y=1331 w=84 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    label bind="app.status" font=ui color=dim text_align=left x=292 y=1387 w=184 h=22 bg=panel radius=8 pad=8,0
    button bind="sampler.stop" text="@sampler.stop_all" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=718 y=1383 w=90 h=28 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    button bind="app.controller.open" tooltip="@app.controller_hint" font=ui color=dim text_align=center x=18 y=1408 w=242 h=16 { state hover { color=text } } 
    label bind="app.audio" font=ui color=dim text_align=center x=840 y=1408 w=242 h=16 
  }
}

// The library: a ribcage. Floats on its own and docks beside the skull in shells without several windows.
window browser role=browser size=800x470 min=400x235 title="@window.browser" chrome=none background=transparent mask="img/browser.png" scale=fit scale_min=50 scale_max=200 snap=true visible=true place="main right -60 700" {
  resize {
    ellipse cx=752 cy=420 rx=20 ry=20
  }
  snap_point 400,0
  free sprite="ribcage:full" {
    label bind="browser.search" text="@browser.search" font=ui color=text text_align=left x=102 y=48 w=150 h=26 editable=true bg=panel2 radius=5 pad=6,0
    label bind="browser.count" text="@browser.tracks" font=small color=dim text_align=center x=256 y=48 w=66 h=26 
    button bind="browser.compatible" text="@browser.compatible" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=326 y=48 w=78 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="browser.columns" text="@browser.columns" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=408 y=48 w=78 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="browser.edit" text="@browser.edit" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=490 y=48 w=58 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="browser.add_to" text="@browser.add_to" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=552 y=48 w=76 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button action="window.hide:browser" text="@skull.close" font=small color=text bg=panel border=line border_w=1 radius=13 transition=90 x=672 y=48 w=26 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    tree bind="browser.tree" text="@browser.collection" bg=panel2 radius=5 font=ui color=text x=102 y=82 w=172 h=166
    button bind="browser.playlist.add_list" text="@playlist.add_list" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=102 y=252 w=84 h=22 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="browser.playlist.add_folder" text="@playlist.add_folder" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=190 y=252 w=84 h=22 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="browser.playlist.add_smart" text="@playlist.add_smart" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=102 y=278 w=84 h=22 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="browser.playlist.rename" text="@playlist.rename" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=190 y=278 w=84 h=22 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="browser.playlist.delete" text="@playlist.delete" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=102 y=304 w=84 h=22 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    browser bind="browser.tracks" columns="title,artist,bpm,key,time" row_h=22 font=ui color=text x=282 y=82 w=416 h=250
    button bind="app.import" text="@app.import_library" show="app.has_import" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=102 y=338 w=84 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="app.export" text="@app.export_usb" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=190 y=338 w=84 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    button bind="deck[1].load" text="@browser.load" args="deck=A" font=small color=deck1 bg=panel border=deck1 border_w=1 radius=6 transition=90 x=282 y=338 w=70 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[2].load" text="@browser.load" args="deck=B" font=small color=deck2 bg=panel border=deck2 border_w=1 radius=6 transition=90 x=356 y=338 w=70 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck2 color=bg } }
    button bind="browser.remove" text="@browser.remove" show="browser.can_remove" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=430 y=338 w=80 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    button action="window.reset" text="@window.reset" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=582 y=366 w=116 h=22 { state hover { bg=hover } state pressed { bg=press } state on { bg=accent color=bg } }
    label bind="preview.title" font=small color=dim text_align=left x=102 y=369 w=440 h=16 
    button bind="preview.play" text="@preview.play" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=102 y=394 w=64 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="preview.stop" text="@preview.stop" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=170 y=394 w=48 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    waveform bind="preview.wave" mode=overview color=accent bg=glass radius=3 x=222 y=394 w=290 h=26
    label bind="preview.time" font=small color=dim text_align=right x=516 y=394 w=66 h=26 
    fader bind="preview.level" orientation=horizontal color=text bg=glass radius=3 x=588 y=399 w=110 h=18
  }
}

// The sampler: a femur. Click a pad to play it, shift-click or the corner square stops it.
window sampler role=sampler size=500x190 min=250x95 title="@window.sampler" chrome=none background=transparent mask="img/sampler.png" scale=fit scale_min=50 scale_max=200 snap=true floating=true visible=false place="main left 40 760" {
  snap_point 250,0
  snap_point 500,95
  free sprite="femur:full" {
    pads bind="sampler.pads" cols=8 rows=2 gap=3 radius=5 color=warn x=70 y=40 w=360 h=80
    fader bind="sampler.level" orientation=horizontal color=warn bg=glass radius=3 x=70 y=130 w=230 h=22
    button bind="sampler.stop" text="@sampler.stop_all" font=small color=text bg=panel border=line border_w=1 radius=6 transition=90 x=306 y=128 w=84 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    button action="window.hide:sampler" text="@skull.close" font=small color=text bg=panel border=line border_w=1 radius=13 transition=90 x=396 y=128 w=34 h=26 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
  }
}

// Grid and cue tools of both decks on a bone tray.
window grid role=grid size=700x300 min=350x150 title="@skull.grid" chrome=none background=transparent mask="img/grid.png" scale=fit scale_min=50 scale_max=200 snap=true visible=false place="main right -40 40" {
  snap_point 350,0
  free sprite="gridtray:full" {
    button action="window.hide:grid" text="@skull.close" font=small color=text bg=panel border=line border_w=1 radius=12 transition=90 x=660 y=6 w=28 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=bad color=bg } }
    label text="@skull.grid" font=title color=ink text_align=left x=24 y=8 w=200 h=20 
    label bind="deck[1].letter" font=title color=deck1 text_align=center x=24 y=44 w=18 h=24 
    button bind="deck[1].metronome" text="@grid.click" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=46 y=44 w=56 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=good color=bg } }
    button bind="deck[1].grid.edit" text="@deck.grid_edit" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=106 y=44 w=50 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    button bind="deck[1].grid.shift_m10" text="-10" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=160 y=44 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.shift_m1" text="-1" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=200 y=44 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.shift_p1" text="+1" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=240 y=44 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.shift_p10" text="+10" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=280 y=44 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.first_beat" text="@grid.first_beat" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=320 y=44 w=70 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.downbeat" text="@grid.downbeat" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=394 y=44 w=84 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.cycle" text="@grid.cycle" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=482 y=44 w=62 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.bpm_m01" text="-.1" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=46 y=72 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.bpm_m001" text="-.01" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=86 y=72 w=40 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    label bind="deck[1].grid.bpm" font=small color=text text_align=center x=130 y=72 w=64 h=24 
    button bind="deck[1].grid.bpm_p001" text="+.01" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=198 y=72 w=40 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.bpm_p01" text="+.1" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=242 y=72 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.half" text="1/2" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=282 y=72 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.double" text="x2" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=322 y=72 w=36 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.tap" text="@grid.tap" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=362 y=72 w=48 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.reanalyse" text="@grid.reanalyse" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=414 y=72 w=70 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.lock" text="@grid.lock" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=488 y=72 w=54 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=warn color=bg } }
    button bind="deck[1].grid.undo" text="@grid.undo" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=546 y=72 w=54 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.add_section" text="@grid.add_section" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=46 y=100 w=76 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
    button bind="deck[1].grid.remove_section" text="@grid.remove_section" font=small color=text bg=panel border=deck1 border_w=1 radius=6 transition=90 x=126 y=100 w=76 h=24 { state hover { bg=hover } state pressed { bg=press } state on { bg=deck1 color=bg } }
