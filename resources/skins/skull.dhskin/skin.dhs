// Hosts the application's tools panel (open it from Settings > Library tools for the tools tabs: stem models, trash, edit history, duplicates, queue).
window tools role=tools size=700x520 min=350x260 title="@app.title" chrome=none background=transparent mask="img/tools.png" scale=fit scale_min=50 scale_max=200 snap=true visible=false place="main right -80 80" {
  free sprite="toolstray:full" {
    free id=content x=16 y=14 w=668 h=492
  }
}

// Hosts the application's settings panel (open it from Settings > Library tools for the tools tabs: stem models, trash, edit history, duplicates, queue).
window settings role=settings size=720x560 min=360x280 title="@app.title" chrome=none background=transparent mask="img/settings.png" scale=fit scale_min=50 scale_max=200 snap=true visible=false place="main right -80 80" {
  free sprite="setstray:full" {
    free id=content x=16 y=14 w=688 h=532
  }
}
