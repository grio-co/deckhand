// Orbit: a free-form, multi-window skin. The main window is two large discs (the decks) joined by a waist that holds the
// mixer, with see-through portholes in the waist; everything outside the shape is transparent to the desktop and clicks
// fall through. The library is a separate capsule-shaped window and the sampler a small round pod, both floating
// independently of the main shape and docking to it (snap) when brought near. Art: img/*.png, generated by
// tools/make_orbit_art.py (original, procedural). Shells that cannot show several windows get the modules docked next to
// the main window over a solid backdrop.
dhskin 1

meta name="Orbit" author="DeckHand contributors" license="MIT" min_version="0.1" description="Free-form two-disc main window with detachable capsule library and sampler pod"

tokens {
  color bg       #05070d
  color panel    #0d1220
  color panel2   #151c2e
  color line     #26314d
  color text     #e6ecff
  color dim      #7f8bb0
  color accent   #35d6ff
  color deck1    #35d6ff
  color deck2    #ff4fd8
  color deck3    #a678ff
  color deck4    #ffb347
  color good     #4be0a0
  color warn     #ffb347
  color bad      #ff5a7a
  color hover    #35d6ff22
  color press    #35d6ff44
  color glass    #070a14d0
  number r 4
  font ui    size=12
  font small size=10 bold=true
  font title size=13 bold=true
  font big   size=20 bold=true
}

atlas main    src="img/main.png"    { region full 0 0 2000 1120 }
atlas capsule src="img/browser.png" { region full 0 0 1520 600 }
atlas pod     src="img/pod.png"     { region full 0 0 600 600 }

shape capsule_shape { rect x=0 y=0 w=760 h=300 radius=150 }
shape podbody { ellipse cx=150 cy=150 rx=150 ry=150 }

animation beat_glow property=glow from=1 to=0 duration=160 ease=out trigger=beat

// One deck on its disc: coordinates are local to the disc's 480x480 box. The tempo fader is a `path` widget that follows
// the rim of the disc; the level meter is an `arc` around the platter.
template flank n color tx td {
  free w=480 h=480 {
    label bind="deck[${n}].title" font=title color=text text_align=center x=145 y=26 w=190 h=18
    waveform bind="deck[${n}].waveform" mode=zoomed color=${color} bg=glass radius=3 x=130 y=48 w=220 h=30
    arc bind="mixer.ch[${n}].level" color=${color} x=95 y=80 w=290 h=290 start=135 end=405 thickness=5
    jog bind="deck[${n}].jog" color=${color} bg=glass border=${color} border_w=1 radius=125 glow=${color} glow_r=14 anim=beat_glow x=115 y=100 w=250 h=250
    label bind="deck[${n}].bpm" font=big color=text text_align=center x=190 y=200 w=100 h=26
    label bind="deck[${n}].key" font=small color=dim text_align=center x=190 y=227 w=100 h=14
    label bind="deck[${n}].time" font=small color=text text_align=center x=190 y=243 w=100 h=14
    path bind="deck[${n}].tempo" d="${td}" viewbox=70x280 color=${color} thickness=4 handle=8 x=${tx} y=100 w=70 h=280
    row gap=5 x=152 y=358 w=176 h=26 {
      button bind="deck[${n}].cue" text="@deck.cue" font=small color=text bg=glass border=${color} border_w=1 radius=13 { state on { bg=warn color=bg } state hover { bg=hover } }
      button bind="deck[${n}].play" text="@deck.play" font=small color=text bg=glass border=${color} border_w=1 radius=13 { state on { bg=good color=bg } state hover { bg=hover } }
      button bind="deck[${n}].sync" text="@deck.sync" font=small color=text bg=glass border=${color} border_w=1 radius=13 { state on { bg=accent color=bg } state hover { bg=hover } }
      button bind="deck[${n}].key_lock" text="@deck.key_lock" font=small color=text bg=glass border=${color} border_w=1 radius=13 { state on { bg=accent color=bg } state hover { bg=hover } }
    }
    pads bind="deck[${n}].pads" cols=4 rows=2 gap=3 radius=5 color=${color} x=140 y=392 w=200 h=40
  }
}

window main size=1000x560 min=500x280 title="@app.title" chrome=none background=transparent mask="img/main.png" mask_threshold=128 scale=fit scale_min=50 scale_max=200 snap=true shadow=auto {
  // a grip on the rim of the right disc resizes the whole window uniformly
  resize {
    ellipse cx=880 cy=455 rx=24 ry=24
  }
  snap_point 500,556
  snap_point 1000,280
  free sprite="main:full" {
    free x=15 y=40 w=480 h=480 {
      use flank n=1 color=deck1 tx=5 td="M 55 8 Q 8 140 55 272"
    }
    free x=505 y=40 w=480 h=480 {
      use flank n=2 color=deck2 tx=405 td="M 15 8 Q 62 140 15 272"
    }
    // the waist: module buttons, EQ and faders, crossfader
    button bind="app.capture.open" show="app.capture_active" tooltip="@capture.indicator_hint" font=small color=bad text_align=center x=388 y=168 w=112 h=18 { state hover { color=text } state on { color=warn } }
    label bind="app.rec_status" show="app.rec_active" font=small color=bad text_align=center x=502 y=168 w=111 h=18
    button action="window.toggle:browser" text="@window.browser" font=small color=text bg=panel2 border=line border_w=1 radius=9 x=388 y=190 w=54 h=19 {
      state hover { bg=hover }
      state on { bg=accent color=bg }
    }
    button action="window.toggle:sampler" text="@window.sampler" font=small color=text bg=panel2 border=line border_w=1 radius=9 x=445 y=190 w=54 h=19 {
      state hover { bg=hover }
      state on { bg=warn color=bg }
    }
    button bind="app.settings" text="@app.settings" font=small color=text bg=panel2 border=line border_w=1 radius=9 x=502 y=190 w=54 h=19 {
      state hover { bg=hover }
      state on { bg=accent color=bg }
    }
    button bind="app.skin" font=small color=text bg=panel2 border=line border_w=1 radius=9 x=559 y=190 w=54 h=19 {
      state hover { bg=hover }
    }
    fader bind="mixer.ch[1].fader" orientation=vertical color=deck1 bg=glass radius=2 x=392 y=216 w=22 h=134
    meter bind="mixer.ch[1].level" orientation=vertical bg=glass x=417 y=216 w=8 h=134
    grid cols=2 rows=3 x=432 y=214 w=136 h=136 {
      knob bind="mixer.ch[1].eq.high" text="@mixer.eq.high" color=deck1 font=small col=0 row=0
      knob bind="mixer.ch[2].eq.high" text="@mixer.eq.high" color=deck2 font=small col=1 row=0
      knob bind="mixer.ch[1].eq.mid" text="@mixer.eq.mid" color=deck1 font=small col=0 row=1
      knob bind="mixer.ch[2].eq.mid" text="@mixer.eq.mid" color=deck2 font=small col=1 row=1
      knob bind="mixer.ch[1].eq.low" text="@mixer.eq.low" color=deck1 font=small col=0 row=2
      knob bind="mixer.ch[2].eq.low" text="@mixer.eq.low" color=deck2 font=small col=1 row=2
    }
    meter bind="mixer.ch[2].level" orientation=vertical bg=glass x=575 y=216 w=8 h=134
    fader bind="mixer.ch[2].fader" orientation=vertical color=deck2 bg=glass radius=2 x=586 y=216 w=22 h=134
    fader bind="mixer.crossfader" orientation=horizontal color=accent bg=glass radius=2 x=400 y=354 w=200 h=18
  }
}

// The library: a capsule that floats on its own, docks under the main window when brought near.
window browser role=browser size=760x300 min=380x150 title="@window.browser" chrome=none background=transparent shape=capsule_shape scale=fit scale_min=60 scale_max=200 snap=true visible=true place="main below 120 -12" {
  resize {
    ellipse cx=700 cy=255 rx=22 ry=22
  }
  snap_point 380,2
  free sprite="capsule:full" {
    label bind="browser.search" text="@browser.search" editable=true font=ui color=text bg=panel2 radius=r pad=6,0 x=112 y=34 w=190 h=26
    label bind="browser.count" text="@browser.tracks" font=small color=dim x=306 y=34 w=72 h=26
    button bind="browser.compatible" text="@browser.compatible" font=small color=text bg=panel2 border=line border_w=1 radius=r x=380 y=34 w=90 h=26 {
      state hover { bg=hover }
      state on { bg=good color=bg }
    }
    button bind="browser.columns" text="@browser.columns" font=small color=text bg=panel2 border=line border_w=1 radius=r x=474 y=34 w=80 h=26 {
      state hover { bg=hover }
      state on { bg=accent color=bg }
    }
    button bind="deck[1].load" text="@browser.load" args="deck=A" font=small color=deck1 bg=panel2 border=line border_w=1 radius=r x=558 y=34 w=44 h=26 {
      state hover { bg=hover }
    }
    button bind="deck[2].load" text="@browser.load" args="deck=B" font=small color=deck2 bg=panel2 border=line border_w=1 radius=r x=606 y=34 w=44 h=26 {
      state hover { bg=hover }
    }
    button action="window.hide:browser" text="x" font=small color=text bg=panel2 border=line border_w=1 radius=13 x=654 y=34 w=26 h=26 {
      state hover { bg=bad color=bg }
    }
    tree bind="browser.tree" text="@browser.collection" bg=panel radius=r font=ui color=text x=96 y=68 w=182 h=172
    browser bind="browser.tracks" columns="title,artist,bpm,time" row_h=20 font=ui color=text x=286 y=68 w=380 h=172
    button bind="preview.play" text="@preview.play" font=small color=text bg=panel2 border=line border_w=1 radius=r x=120 y=248 w=56 h=26 {
      state hover { bg=hover }
      state on { bg=good color=bg }
    }
    button bind="preview.stop" text="@preview.stop" font=small color=text bg=panel2 border=line border_w=1 radius=r x=180 y=248 w=44 h=26 {
      state hover { bg=hover }
    }
    waveform bind="preview.wave" mode=overview color=accent bg=panel2 radius=2 x=230 y=248 w=190 h=26
    label bind="preview.time" font=small color=dim text_align=right x=424 y=248 w=70 h=26
    button action="window.reset" text="@window.reset" font=small color=text bg=panel2 border=line border_w=1 radius=r x=504 y=248 w=96 h=26 {
      state hover { bg=hover }
    }
  }
}

// The sampler: a small round pod above everything else; only its outer ring drags it.
window sampler role=sampler size=300x300 min=150x150 title="@window.sampler" chrome=none background=transparent shape=podbody scale=fit scale_min=60 scale_max=200 snap=true floating=true visible=true place="main right 14 150" {
  drag {
    ellipse cx=150 cy=150 rx=150 ry=150
    ellipse cx=150 cy=150 rx=112 ry=112 op=sub
  }
  snap_point 0,150
  free sprite="pod:full" {
    pads bind="sampler.pads" cols=4 rows=4 gap=3 radius=4 color=warn x=72 y=52 w=156 h=156
    button action="window.hide:sampler" text="x" font=small color=text bg=panel2 border=line border_w=1 radius=9 x=132 y=16 w=36 h=18 {
      state hover { bg=bad color=bg }
    }
    fader bind="sampler.level" orientation=horizontal color=warn bg=glass radius=2 x=66 y=228 w=108 h=18
    button bind="sampler.stop" text="@sampler.stop_all" font=small color=text bg=panel2 border=line border_w=1 radius=9 x=180 y=227 w=54 h=20 {
      state hover { bg=hover }
    }
  }
}
