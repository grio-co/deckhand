// Version info and UTF-8 manifest for the console programs (deckhand-engine, deckhandctl, tests).
#include <winver.h>

1 24 "console.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "DeckHand contributors\0"
      VALUE "FileDescription", "DeckHand DJ software (command line part)\0"
      VALUE "FileVersion", "0.1.0.0\0"
      VALUE "ProductName", "DeckHand\0"
      VALUE "ProductVersion", "0.1.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
